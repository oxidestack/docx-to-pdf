{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "The values of charts/docx-to-pdf. Every object the chart reads key by key is closed, so a misspelt value fails `helm install`, `helm template` and `helm lint`; an object passed through to Kubernetes as it is (a probe, a security context, affinity, a volume source) is left open, and the API server validates it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "poolSize", "instanceHardMemoryMiB", "shutdownGraceSeconds", "preStopSleepSeconds", "tmp"],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "object": {
      "type": "object"
    },
    "probe": {
      "$comment": "null or {} leaves the probe out.",
      "type": ["object", "null"]
    },
    "intOrPercent": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^([0-9]+%?)?$" }
      ]
    }
  },
  "properties": {
    "global": {
      "$comment": "Helm passes `global` to every chart; this one reads nothing from it.",
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": { "type": "object" }
      }
    },
    "poolSize": { "type": "integer", "minimum": 1 },
    "instanceHardMemoryMiB": {
      "$comment": "0 (no hard limit) is the service's setting, and the chart then needs `resources` set (the template says so).",
      "type": "integer",
      "minimum": 0
    },
    "shutdownGraceSeconds": { "type": "integer", "minimum": 0 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "config": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string" },
        "protocol": { "enum": ["", "http/protobuf", "grpc"] },
        "resourceAttributes": { "type": "string" }
      }
    },
    "networkPolicy": {
      "$comment": "The peers are passed to the NetworkPolicy as they are; the API server validates them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "$ref": "#/definitions/object" } },
        "dnsTo": { "type": "array", "items": { "$ref": "#/definitions/object" } },
        "otlpTo": { "type": "array", "items": { "$ref": "#/definitions/object" } }
      }
    },
    "probePort": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 65535 },
        { "type": "string", "pattern": "^([1-9][0-9]{0,4})?$" }
      ]
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "medium": { "enum": ["", "Memory"] },
        "sizeMiB": { "type": "integer", "minimum": 0 }
      }
    },
    "fonts": {
      "$comment": "Any volume source, e.g. {secret: {secretName: licensed-fonts}}.",
      "type": "object"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "$ref": "#/definitions/intOrPercent" },
        "minAvailable": { "$ref": "#/definitions/intOrPercent" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "podSecurityContext": { "$ref": "#/definitions/object" },
    "securityContext": { "$ref": "#/definitions/object" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "$ref": "#/definitions/object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 }
      }
    }
  }
}
